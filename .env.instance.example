# Instance Configuration Template
# Copy this file to .env.instance1, .env.instance2, etc.
# Then run: COMPOSE_PROJECT_NAME=mcp-inst1 docker compose --env-file .env.instance1 up -d

# Database Configuration (use unique ports per instance)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=mcp_app
DB_PASSWORD=mcp_password
DB_DATABASE=poc_origin
MYSQL_ROOT_PASSWORD=password

# Security Configuration
CREDENTIALS_ENCRYPTION_KEY=your-32-character-encryption-key-here

# LLM Configuration
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# Application Configuration (use unique ports per instance)
BACKEND_PORT=3001
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3001
